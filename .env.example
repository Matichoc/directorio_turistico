# Supabase — proyecto del panel admin/base de datos.
# Se obtienen en supabase.com > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo en server actions/route handlers, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Esquema de Postgres con las tablas del directorio. Déjala vacía: en el
# proyecto compartido con Papudo se usa `legacy` solo (y `public` se rechaza,
# porque ahí `public` es de Papudo); en cualquier otro proyecto, `public`.
# Ver docs/SUPABASE-LEGACY.md.
NEXT_PUBLIC_SUPABASE_SCHEMA=

# Mapas — estilo MapLibre (JSON style URL). El proveedor comercial
# definitivo está pendiente de definir antes de producción (ver
# docs/PLAN.md, sección Riesgos). Si se deja vacío usa OpenFreeMap
# "liberty" (gratis, sin API key), oscurecido para ir a juego con el sitio
# (ver src/lib/maps/config.ts).
NEXT_PUBLIC_MAP_STYLE_URL=

# URL pública del sitio (dominio real en producción, sin "/" final): de acá
# salen los links absolutos del sitemap, el canonical/hreflang y las vistas
# previas al compartir (WhatsApp/Facebook). Si se deja vacía, se usa el
# dominio de Vercel como respaldo (ver getSiteUrl en src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Places API (New) — usada por `pnpm fetch:google-photos` y
# src/app/api/place-photo/route.ts (fotos reales de lugares). Requiere un
# proyecto de Google Cloud con facturación habilitada y "Places API (New)"
# activada. Secreta: solo se usa en scripts y route handlers de servidor,
# nunca se expone al navegador. (La guía paso a paso ya no usa Google: ver
# las variables de rutas más abajo.)
GOOGLE_PLACES_API_KEY=

# Guía paso a paso (src/app/api/ruta/route.ts): rutas por calle con giros
# desde OSRM (OpenStreetMap). Opcionales: vacías usan los servidores públicos
# de FOSSGIS (gratis, máximo 1 consulta por segundo); para más tráfico,
# apuntarlas a un servidor OSRM propio.
ROUTING_OSRM_WALK_URL=
ROUTING_OSRM_CAR_URL=
