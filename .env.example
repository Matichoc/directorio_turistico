# Supabase — proyecto del panel admin/base de datos.
# Se obtienen en supabase.com > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo en server actions/route handlers, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Mapas — estilo MapLibre (JSON style URL). El proveedor comercial
# definitivo está pendiente de definir antes de producción (ver
# docs/PLAN.md, sección Riesgos). Por defecto usa el estilo demo gratuito
# de MapLibre si se deja vacío.
NEXT_PUBLIC_MAP_STYLE_URL=

# URL pública del sitio (dominio real en producción, sin "/" final): de acá
# salen los links absolutos del sitemap, el canonical/hreflang y las vistas
# previas al compartir (WhatsApp/Facebook). Si se deja vacía, se usa el
# dominio de Vercel como respaldo (ver getSiteUrl en src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Places API (New) + Routes API — usada por `pnpm fetch:google-photos`,
# src/app/api/place-photo/route.ts (fotos reales de lugares) y
# src/app/api/directions/route.ts (ruta real por calle del mapa de
# navegación en vivo). Requiere un proyecto de Google Cloud con facturación
# habilitada y AMBAS APIs activadas: "Places API (New)" y "Routes API" (ver
# docs/PLAN.md, sección Riesgos, para el paso a paso). Secreta: solo se usa
# en scripts y route handlers de servidor, nunca se expone al navegador.
GOOGLE_PLACES_API_KEY=
