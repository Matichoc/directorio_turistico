# Supabase — proyecto del panel admin/base de datos.
# Se obtienen en supabase.com > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo en server actions/route handlers, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Mapas — estilo MapLibre (JSON style URL). El proveedor comercial
# definitivo está pendiente de definir antes de producción (ver
# docs/PLAN.md, sección Riesgos). Por defecto usa el estilo demo gratuito
# de MapLibre si se deja vacío.
NEXT_PUBLIC_MAP_STYLE_URL=

# URL pública del sitio, usada en metadata/hreflang y notificaciones.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link del banner de auspicio de Matichoc (src/components/ui/sponsor-banner.tsx).
# Si se deja vacío, usa https://www.matichoc.cl por defecto.
NEXT_PUBLIC_SPONSOR_URL=
# Instagram de Matichoc, opcional. Si se deja vacío, el banner no muestra el
# link (no inventamos una cuenta sin verificar).
NEXT_PUBLIC_SPONSOR_INSTAGRAM_URL=

# Google Places API (New) — usada por `pnpm fetch:google-photos` y por
# src/app/api/place-photo/route.ts para mostrar fotos reales de lugares que
# no tienen una foto curada a mano. Requiere un proyecto de Google Cloud con
# facturación habilitada y la API "Places API (New)" activada (ver
# docs/PLAN.md, sección Riesgos, para el paso a paso). Secreta: solo se usa
# en scripts y route handlers de servidor, nunca se expone al navegador.
GOOGLE_PLACES_API_KEY=
